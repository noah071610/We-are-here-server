{
  "name": "we-are-here-server",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "typegen": "wrangler types",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:hard_reset": "rm -rf .wrangler && rm -rf drizzle && npm run db:generate && npm run db:migrate",
    "db:hard_reset:remote": "npm run db:hard_reset && wrangler d1 execute we-are-here-db --remote --file=./scripts/d1-remote-nuke.sql && wrangler d1 migrations apply we-are-here-db --remote",
    "db:migrate": "wrangler d1 migrations apply we-are-here-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply we-are-here-db --remote",
    "db:migrate:kit": "drizzle-kit migrate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@hono/trpc-server": "0.4.2",
    "@trpc/server": "11.17.0",
    "@upstash/redis": "1.38.0",
    "bcryptjs": "3.0.3",
    "better-auth": "1.6.9",
    "drizzle-orm": "0.45.2",
    "hono": "^4.12.18",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/node": "25.6.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "tsx": "4.21.0",
    "wrangler": "4.88.0"
  }
}
